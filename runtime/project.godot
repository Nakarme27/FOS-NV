; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenNV"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="OpenNV"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/queries/enable_ray_cast_face_index=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
driver/threads/thread_model=1
limits/global_shader_variables/buffer_size=262144
textures/vram_compression/import_etc2_astc=true

[shader_globals]

opennv_exterior_ambient={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
opennv_exterior_fog_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
opennv_exterior_fog_range={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
opennv_detail_region={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[xr]

openxr/startup_alert=false
shaders/enabled=true
